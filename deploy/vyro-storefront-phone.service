[Unit]
Description=VYRO storefront phone settings

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/vyro/storefront-phone.py
DynamicUser=yes
Group=www-data
RuntimeDirectory=vyro-storefront-phone
RuntimeDirectoryMode=0750
StateDirectory=vyro-storefront-phone
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
